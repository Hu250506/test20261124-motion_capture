# 복사해서 사용: cp .env.example .env  (.env는 Git에 올리지 않습니다)

# ── PostgreSQL ──
POSTGRES_DB=vision_action
POSTGRES_USER=vision
POSTGRES_PASSWORD=change-me-db-password

# ── Django ──
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── 입력 제한 ──
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=60
AI_REQUEST_TIMEOUT=300

# ── IP Webcam ──
# 허용할 카메라만 "이름|주소"로 등록합니다. 여러 대는 쉼표로 구분합니다.
# 사용자는 화면에서 '이름'만 고르고, 실제 주소는 여기에만 있습니다.
# 예: 휴대폰 IP Webcam 앱 → ALLOWED_CAMERAS=lab-phone|http://192.168.0.10:8080/video
ALLOWED_CAMERAS=
CAMERA_CAPTURE_SECONDS=8
CAMERA_CONNECT_TIMEOUT=10

# ── (선택) FastAPI 이미지의 PyTorch 설치 주소. 기본은 CPU 전용(용량이 작음) ──
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
